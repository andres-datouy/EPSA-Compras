  "partitions": [
    {
      "name": "DateAutoTemplate",
      "mode": "import",
      "state": "ready",
      "modifiedTime": "2026-05-28T17:26:57.71",
      "refreshedTime": "2026-05-28T17:26:57.71",
      "source": {
        "type": "calculated",
        "expression": "\n--  \n--     Configuration\n--  \nVAR __FirstFiscalMonth = 2\nVAR __MonthsInYear = 12\n-- Fiscal year as Calendar Year of :\n-- 0 - First day of fiscal year\n-- 1 - Last day of fiscal year\nVAR __TypeStartFiscalYear = 1\n----------------------------------------\nVAR __OffsetFiscalMonthNumber = __MonthsInYear + 1 - (__MonthsInYear - 12)\nVAR __Calendar = \n    VAR __FirstYear = YEAR ( MINX ( { MIN ( 'factConsumoHistoria'[Consumo Fecha] ) }, ''[Value] ) )\n    VAR __LastYear =  YEAR ( MAXX ( { MAX ( 'factConsumoHistoria'[Consumo Fecha] ) }, ''[Value] ) )\n    RETURN CALENDAR (\n        DATE ( __FirstYear, 1, 1 ),\n        DATE ( __LastYear, 12, 31 )\n    )\nVAR __Step3 = \n    GENERATE (\n        __Calendar,\n        VAR __IsStandardLocale = IF ( FORMAT( DATE( 2000, 1, 1 ), \"oooo\", \"es-AR\" ) = \"oooo\", TRUE, FALSE )\n        VAR __MonthFormatString = IF( __IsStandardLocale, \"mmm\", \"ooo\" )\n        VAR __Date = [Date]\n        VAR __YearMonthNumber = YEAR ( __Date ) * __MonthsInYear + MONTH ( __Date ) - 1\n        VAR __FiscalMonthNumber = MOD ( __YearMonthNumber + 1 * (__FirstFiscalMonth > 1) * (__MonthsInYear + 1 - __FirstFiscalMonth), __MonthsInYear ) + 1\n        VAR __MonthNumber = \n            IF (\n                __FiscalMonthNumber <= 12 && __FirstFiscalMonth > 1,\n                __FiscalMonthNumber + __FirstFiscalMonth\n                    - IF (\n                        __FiscalMonthNumber > (__OffsetFiscalMonthNumber - __FirstFiscalMonth),\n                        __OffsetFiscalMonthNumber,\n                        1\n                    ),\n                __FiscalMonthNumber\n            )\n        VAR __FiscalYearNumber = QUOTIENT ( __YearMonthNumber + __TypeStartFiscalYear * (__FirstFiscalMonth > 1) * (__MonthsInYear + 1 - __FirstFiscalMonth), __MonthsInYear )\n        VAR __YearNumber = __FiscalYearNumber - 1 * (__MonthNumber > __FiscalMonthNumber)\n        VAR __MonthDate = DATE ( __YearNumber, __MonthNumber, 1 )\n        VAR __FiscalMonthInQuarterNumber = MOD ( __FiscalMonthNumber - 1, 3 ) + 1 + 3 * ( __MonthNumber > 12 )\n        VAR __FiscalQuarterNumber = MIN ( ROUNDUP ( __FiscalMonthNumber / 3, 0 ), 4 )\n        VAR __FiscalYearQuarterNumber = __FiscalYearNumber * 4 + __FiscalQuarterNumber - 1\n        RETURN ROW ( \n            \"Year Month Key\", __YearNumber * 100 + __MonthNumber,\n            \"Year Month\", \n                IF (\n                    __MonthNumber > 12,\n                    FORMAT ( __MonthNumber, \"@_M_@00\", \"es-AR\" ) & FORMAT ( __YearNumber, \" 0000\", \"es-AR\" ),\n                    FORMAT ( __MonthDate, __MonthFormatString & \" yyyy\", \"es-AR\" )\n                ),\n            \"Year Month Number\", __YearMonthNumber,\n            \"Fiscal Month\", \n                IF (\n                    __MonthNumber > 12,\n                    FORMAT ( __MonthNumber, \"@_M_@00\", \"es-AR\" ),\n                    FORMAT ( __MonthDate, __MonthFormatString, \"es-AR\" )\n                ),\n            \"Fiscal Month Number\", __FiscalMonthNumber,\n            \"Fiscal Month in Quarter Number\", __FiscalMonthInQuarterNumber,\n            \"Fiscal Quarter\", FORMAT( __FiscalQuarterNumber, \"\\F\\Q0\", \"es-AR\" ),\n            \"Fiscal Year Quarter\", FORMAT ( __FiscalQuarterNumber, \"\\F\\Q0\", \"es-AR\" ) & \"-\" & FORMAT ( __FiscalYearNumber, \"0000\", \"es-AR\" ),\n            \"Fiscal Year Quarter Number\", __FiscalYearQuarterNumber,\n            \"Fiscal Year\", FORMAT ( __FiscalYearNumber, \"\\F\\Y 0000\", \"es-AR\" ),\n            \"Fiscal Year Number\", __FiscalYearNumber \n        )\n    )\nRETURN\n    __Step3"
      }
    }
  ],
