    {
      "name": "_RangoFechas_Debug",
      "expression": "\nVAR MinFact = MIN ( factConsumoHistoria[Consumo Fecha] )\nVAR MaxFact = MAX ( factConsumoHistoria[Consumo Fecha] )\nVAR MinCal  = MIN ( Calendario[Fecha] )\nVAR MaxCal  = MAX ( Calendario[Fecha] )\nRETURN\n\"Fact: \" & FORMAT ( MinFact, \"dd/MM/yyyy\" ) & \" - \" & FORMAT ( MaxFact, \"dd/MM/yyyy\" )\n& \" | Cal: \" & FORMAT ( MinCal, \"dd/MM/yyyy\" ) & \" - \" & FORMAT ( MaxCal, \"dd/MM/yyyy\" )\n",
      "lineageTag": "ad5703d6-d6ba-4248-aa7e-d7b91cb2b1a1",
      "dataType": "string",
