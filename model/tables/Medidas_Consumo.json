    },
    {
      "name": "Consumo Promedio por Mes Activo C.Ext.",
      "expression": "\nVAR ArticulosVisibles = VALUES(dimArticulo[Artículo Código])\nRETURN\n    CALCULATE(\n        [Consumo Promedio por Mes Activo],\n        REMOVEFILTERS(dimArticulo),\n        TREATAS(ArticulosVisibles, factConsumoHistoria[Consumo Artículo Código])\n    )",
