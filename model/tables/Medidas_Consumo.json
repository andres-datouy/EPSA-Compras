    {
      "name": "Promedio Consumo por Movimiento",
      "expression": "\nDIVIDE ( abs([Sumatoria Movs Consumo Sin Recepciones]), [Consumos] )\n",
      "formatString": "#,0",
      "lineageTag": "a70aef43-0d61-4d43-912c-f4e6978e9c67",
