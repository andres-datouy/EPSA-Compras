          "modifiedTime": "2025-11-26T11:32:13.736667"
        }
      ]
    },
    {
      "name": "Meses con Consumo",
      "expression": "\nCOUNTROWS(\n    FILTER(\n        VALUES(Calendario[Año Mes]),\n        [Sumatoria Movs Consumo Sin Recepciones] <> 0\n    )\n)\n/*\nVAR MesesConConsumo =\n    SUMMARIZE(\n        ADDCOLUMNS(\n            factConsumoHistoria,\n            -- Columna calculada solo para agrupar por mes\n            \"Mes\",\n                EOMONTH ( factConsumoHistoria[Consumo Fecha], 0 )\n        ),\n        [Mes],  -- <-- acá sí es una columna\n        \"ConsumoMes\",\n            [Sumatoria Movs Consumo Sin Recepciones]\n    )\nRETURN\n    COUNTROWS (\n        FILTER (\n            MesesConConsumo,\n            [ConsumoMes] <> 0\n        )\n    )\n*/",
      "formatString": "0",
      "lineageTag": "e95f2bc5-22f5-48aa-8c38-79f6a4f100d2",
      "dataType": "int64",
      "modifiedTime": "2026-05-13T13:46:12.07",
      "structureModifiedTime": "2025-11-26T11:32:13.736667"
    },
    {
      "name": "Consumo Promedio por Mes Activo",
      "expression": "\nVAR Numerador = [Sumatoria Movs Consumo Sin Recepciones]\nVAR Denominador = [Meses con Consumo]\nVAR Resultado = DIVIDE(Numerador, Denominador)\nRETURN\n    COALESCE(Resultado, 0)\n\n",
      "formatString": "#,0",
      "lineageTag": "4edc80d2-103b-4f74-855f-b62e236955eb",
      "dataType": "double",
      "modifiedTime": "2026-05-13T15:05:04.16",
