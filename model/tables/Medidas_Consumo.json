    },
    {
      "name": "Consumo Medio por Artículo",
      "expression": "\nVAR MovimientosArticulo =\n    CALCULATE ( [Consumos], ALLEXCEPT ( factConsumoHistoria, factConsumoHistoria[Consumo Artículo Código] ) )\nRETURN\nDIVIDE ( [Consumo Cantidad], MovimientosArticulo )\n",
      "lineageTag": "beb895a3-9b4d-4d93-95c4-d409de30de29",
      "dataType": "double",
      "modifiedTime": "2025-11-26T11:32:14.103333",
