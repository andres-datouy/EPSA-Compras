    },
    {
      "name": "Sumatoria Movs Consumo Sin Recepciones",
      "expression": "\nabs(CALCULATE(\n    SUM( factConsumoHistoria[Consumo Cantidad] ),\n    factConsumoHistoria[Consumo Documento] <> \"recstktr\"\n))\n",
      "formatString": "#,0",
      "lineageTag": "646a64a6-3ae7-4440-b4df-89113be52c31",
      "dataType": "double",
      "modifiedTime": "2025-11-26T11:32:14.103333",
      "structureModifiedTime": "2025-11-26T11:32:13.736667",
      "annotations": [
