  "partitions": [
    {
      "name": "dimProveedor",
      "mode": "import",
      "state": "ready",
      "modifiedTime": "2026-05-13T19:39:44.5",
      "refreshedTime": "2026-05-28T17:25:58.33",
      "source": {
        "type": "m",
        "expression": "let\n    Origen = Sql.Database(\"192.168.2.7\", \"Nodum\", [Query=\"select p.cod_tit, p.nom_tit, p.dir_tit, p.ciudad_tit, ciu.nom_ciudad,#(lf)p.cod_provincia, prov.nom_provincia, #(lf)p.cod_pais, pais.nom_pais,#(lf)p.tel_tit, p.email_tit, p.origen_tit,#(lf)p.cod_clase_prov, cp.nom_clase_prov,#(lf)p.cod_fpago, fp.nom_fpago, #(lf)p.nro_dgi, p.status_prov#(lf)from ct_proveedores p#(lf)left join ct_paises pais on pais.cod_pais=p.cod_pais#(lf)left join ct_provincias prov on prov.cod_provincia = p.cod_provincia and prov.cod_pais = p.cod_pais#(lf)left join ct_ciudades ciu on ciu.ciudad_tit=p.ciudad_tit and ciu.cod_provincia=p.cod_provincia and ciu.cod_pais=p.cod_pais#(lf)left join ct_clasesprov cp on cp.cod_clase_prov=p.cod_clase_prov#(lf)left join ct_fpagos fp on fp.cod_fpago=p.cod_fpago#(lf)where  exists (select 1, * from epsa_bi.dbo.vw_ComprasBI_RecepcionesHistoria h where h.OCProveedor = p.cod_tit)\"]),\n    #\"Columnas con nombre cambiado\" = Table.RenameColumns(Origen,{{\"cod_tit\", \"Proveedor Id\"}, {\"nom_tit\", \"Proveedor Nombre\"}, {\"dir_tit\", \"Proveedor Dirección\"}, {\"ciudad_tit\", \"Proveedor Ciudad\"}, {\"nom_ciudad\", \"Proveedor Ciudad Nombre\"}, {\"cod_provincia\", \"Proveedor Departamento\"}, {\"nom_provincia\", \"Proveedor Nombre Departamento\"}, {\"cod_pais\", \"País Código\"}, {\"nom_pais\", \"País Nombre\"}, {\"tel_tit\", \"Proveedor Teléfono\"}, {\"email_tit\", \"Proveedor Email\"}, {\"origen_tit\", \"Proveedor Origen\"}, {\"cod_clase_prov\", \"Proveedor Clase Id\"}, {\"nom_clase_prov\", \"Proveedor Clase Nombre\"}, {\"cod_fpago\", \"Proveedor Forma de Pago\"}, {\"nom_fpago\", \"Proveedor Forma de Pago Nombre\"}, {\"nro_dgi\", \"Proveedor RUT\"}, {\"status_prov\", \"Proveedor Status\"}})\nin\n    #\"Columnas con nombre cambiado\""
      }
    }
  ],
