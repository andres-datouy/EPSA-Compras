  "partitions": [
    {
      "name": "factConsumoHistoria",
      "mode": "import",
      "state": "ready",
      "modifiedTime": "2026-05-13T19:39:44.5",
      "refreshedTime": "2026-05-28T17:26:25.033333",
      "source": {
        "type": "m",
        "expression": "let\n    Origen = Sql.Database(\"192.168.2.7\", \"Nodum\", [Query=\"select s.formulario, s.nro_trans, s.cod_docum, s.nro_docum, s.fec_doc, s.cod_tit, s.cod_estado, s.cod_articulo, a.nom_articulo, (s.cantidad*s.signo) as cantidad, a.cod_tipoart,#(lf)Obligatorio = isnull((select case when (select count(*) from ct_prdcomponente where cod_articulo = s.cod_articulo and es_obligatorio = 'S') > 0 then 'S' else 'N' end),'N')#(lf)from cpf_stockaux s #(lf)join ct_articulos a on s.cod_articulo = a.cod_articulo#(lf)where s.cod_emp = 'EPSA' #(lf)and cod_estado in ('existencia')#(lf)and s.fec_doc between DATEFROMPARTS(YEAR(GETDATE()) - 5, 2, 1) and getdate()#(lf)and s.cod_docum not in ('recepi')#(lf)and a.cod_tipoart not in ('prvta', 'pt', 'semi', 'tubos')\"]),\n    #\"Columnas con nombre cambiado\" = Table.RenameColumns(Origen,{{\"nro_docum\", \"Consumo Nº Documento\"}, {\"fec_doc\", \"Consumo Fecha\"}, {\"cod_tit\", \"Consumo Depósito\"}, {\"cod_docum\", \"Consumo Documento\"}, {\"nro_trans\", \"Consumo Transacción\"}, {\"formulario\", \"Consumo Formulario\"}, {\"cod_estado\", \"Consumo Estado\"}, {\"cod_articulo\", \"Consumo Artículo\"}, {\"cantidad\", \"Consumo Cantidad\"}}),\n    #\"Columnas quitadas\" = Table.RemoveColumns(#\"Columnas con nombre cambiado\",{\"nom_articulo\", \"cod_tipoart\"}),\n    #\"Fecha extraída\" = Table.TransformColumns(#\"Columnas quitadas\",{{\"Consumo Fecha\", DateTime.Date, type date}}),\n    #\"Columnas con nombre cambiado1\" = Table.RenameColumns(#\"Fecha extraída\",{{\"Consumo Artículo\", \"Consumo Artículo Código\"}, {\"Obligatorio\", \"Consumo Obligatorio\"}})\nin\n    #\"Columnas con nombre cambiado1\""
      }
    }
