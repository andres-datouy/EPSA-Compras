      "source": {
        "type": "m",
        "expression": "let\n    Origen = Sql.Database(\"192.168.2.7\", \"Nodum\", [Query=\"#(tab)select 'Solicitud' as Tipo, s.cod_tit, s.cod_doca, s.serie_doca, s.nro_doca, s.cod_articulo, a.cod_tipoart, sum(cantidad*signo) as Cant, max(s.fecha_mod) as FechaUltimaMod, max(s.fec_entrega) as FechaEntregaMax#(lf)#(tab)from cps_solicitudes s#(lf)#(tab)join ct_articulos a on a.cod_articulo = s.cod_articulo#(lf)#(tab)where s.cod_emp = 'epsa'#(lf)#(tab)and a.cod_tipoart not in ('pt', 'prvta', 'semi', 'tubos', 'servta')#(lf)#(tab)group by s.cod_tit,  s.cod_doca, s.serie_doca, s.nro_doca, s.cod_articulo, a.cod_tipoart#(lf)#(tab)having sum(cantidad*signo)>0 and year(max(s.fecha_mod) )>= year(getdate())-5#(lf)#(tab)union#(lf)#(tab)select 'Orden de Compra' as Tipo, o.cod_tit, o.cod_doca, o.serie_doca, o.nro_doca, o.cod_articulo, a.cod_tipoart, sum(cantidad*signo) as Cant, max(o.fecha_mod) as FechaUltimaMod, max(o.fec_entrega) as FechaEntregaMax#(lf)#(tab)from cps_ocompras o#(lf)#(tab)join ct_articulos a on a.cod_articulo = o.cod_articulo#(lf)#(tab)where o.cod_emp = 'epsa'#(lf)#(tab)and a.cod_tipoart not in ('pt', 'prvta', 'semi', 'tubos', 'servta')#(lf)#(tab)group by o.cod_tit, o.cod_doca, o.serie_doca, o.nro_doca, o.cod_articulo, a.cod_tipoart#(lf)#(tab)having sum(cantidad*signo)>0 and year(max(o.fecha_mod) )>= year(getdate())-5#(lf)#(tab)union#(lf)#(tab)select 'Carpeta Import' as Tipo, o.cod_tit, o.cod_doca, o.serie_doca, o.nro_doca, o.cod_articulo, a.cod_tipoart, sum(cantidad*signo) as Cant, max(o.fecha_mod) as FechaUltimaMod, max(ent.fec_entrega) as fec_entrega#(lf)#(tab)from cpf_stockaux o#(lf)#(tab)join ct_articulos a on a.cod_articulo = o.cod_articulo#(lf)#(tab)outer apply (select max(fec_entrega) as fec_entrega#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)from cpp_importacione i #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)where i.cod_docum=o.cod_doca and i.nro_docum=o.nro_doca and i.cod_articulo=o.cod_articulo) as ent#(lf)#(tab)where o.cod_emp = 'epsa'#(lf)#(tab)and a.cod_tipoart not in ('pt', 'prvta', 'semi', 'tubos', 'servta')#(lf)#(tab)and cod_estado in ('compras')#(lf)#(tab)and not exists (#(lf)#(tab)#(tab)select 1#(lf)#(tab)#(tab)from cps_ocompras oc#(lf)#(tab)#(tab)join ct_articulos a on a.cod_articulo = oc.cod_articulo#(lf)#(tab)#(tab)where oc.cod_emp = o.cod_emp#(lf)#(tab)#(tab)and a.cod_tipoart not in ('pt', 'prvta', 'semi', 'tubos', 'servta')#(lf)#(tab)#(tab)and a.cod_articulo = o.cod_articulo#(lf)#(tab)#(tab)and oc.cod_tit = o.cod_tit and oc.cod_doca = o.cod_doca and oc.serie_doca = o.serie_doca#(lf)#(tab)#(tab)and oc.nro_doca = o.nro_doca#(lf)#(tab)#(tab)group by oc.cod_tit, oc.cod_doca, oc.serie_doca, oc.nro_doca, oc.cod_articulo, a.cod_tipoart#(lf)#(tab)#(tab)having sum(cantidad*signo)>0#(lf)#(tab))#(lf)#(tab)group by o.cod_tit, o.cod_doca, o.serie_doca, o.nro_doca, o.cod_articulo, a.cod_tipoart#(lf)#(tab)having sum(cantidad*signo)>0 and year(max(o.fecha_mod) )>= year(getdate())-5\"]),\n    #\"Columnas con nombre cambiado\" = Table.RenameColumns(Origen,{{\"Tipo\", \"CompraEP Tipo\"}, {\"cod_tit\", \"CompraEP Proveedor\"}, {\"cod_doca\", \"CompraEP Doc\"}, {\"serie_doca\", \"CompraEP Serie\"}, {\"nro_doca\", \"CompraEP Numero\"}, {\"cod_articulo\", \"CompraEP Articulo Codigo\"}, {\"Cant\", \"CompraEP Cantidad\"}, {\"FechaUltimaMod\", \"CompraEP Fecha Ultima Modificacion\"}, {\"FechaEntregaMax\", \"CompraEP Ultima Fecha Entrega\"}})\nin\n    #\"Columnas con nombre cambiado\""
